{
  "name": "livelylyrics-miniplayer",
  "version": "2.2.3",
  "description": "Powerful & accurate floating transparent Spotify & Music synced lyrics miniplayer for Windows, macOS, and Linux",
  "main": "main.js",
  "scripts": {
    "postinstall": "node node_modules/electron/install.js || true",
    "start": "electron .",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:all": "electron-builder -mwl"
  },
  "keywords": [
    "spotify",
    "apple-music",
    "lyrics",
    "miniplayer",
    "floating",
    "windows",
    "macos",
    "linux",
    "mpris",
    "smtc"
  ],
  "author": {
    "name": "LivelyLyrics",
    "email": "support@livelylyrics.app"
  },
  "license": "MIT",
  "build": {
    "appId": "com.livelylyrics.miniplayer",
    "productName": "LivelyLyrics",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "bridge/**/*",
      "services/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icon.icns",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "LivelyLyrics membutuhkan izin untuk membaca lagu yang sedang diputar dan mengontrol pemutaran di Spotify atau Apple Music.",
        "LSUIElement": false
      }
    },
    "linux": {
      "maintainer": "LivelyLyrics <support@livelylyrics.app>",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icon.png",
      "category": "Audio",
      "synopsis": "Floating Synced Lyrics Miniplayer for Spotify & MPRIS Players"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "LivelyLyrics"
    },
    "asarUnpack": [
      "bridge/**/*",
      "public/icon.png",
      "public/icon.icns",
      "public/icon.ico",
      "public/icon-16.png",
      "public/icon-32.png",
      "public/trayTemplate.png",
      "public/trayTemplate@2x.png"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "malikp66",
        "repo": "lively-lyrics"
      }
    ]
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.3",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "electron-updater": "^6.8.9"
  }
}
