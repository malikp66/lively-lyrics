{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "LivelyLyrics",
  "version": "3.0.0",
  "identifier": "com.starvodev.livelylyrics",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "LivelyLyrics",
        "url": "index.html",
        "width": 520,
        "height": 140,
        "minWidth": 320,
        "minHeight": 110,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "Pengaturan LivelyLyrics",
        "url": "settings.html",
        "width": 500,
        "height": 530,
        "minWidth": 460,
        "minHeight": 400,
        "resizable": true,
        "fullscreen": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
